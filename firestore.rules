rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function participaDaLista(listaId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/listas/$(listaId)).data.participantes;
    }

    // Mesma lista de src/config/admins.js: ao mudar uma, mude a outra.
    function ehAdmin() {
      return logado() && request.auth.token.email in [
        'tm_barchi@hotmail.com',
        'guiicamargo98@gmail.com'
      ];
    }

    // Quem ainda não participa do grupo só pode mexer em `participantes`,
    // e só para se acrescentar (entrar pelo link ?lista=<id>).
    function soEntrandoNoGrupo() {
      let antes = resource.data.participantes.toSet();
      let depois = request.resource.data.participantes.toSet();
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantes'])
        && depois.difference(antes) == [request.auth.uid].toSet()
        && antes.difference(depois).size() == 0;
    }

    match /catalogo/{produtoId} {
      allow read: if logado();
      allow write: if ehAdmin();
      // Qualquer logado registra preço, mas só acrescentando um registro:
      // apagar ou alterar o histórico continua sendo de admin.
      allow update: if logado()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['historico'])
        && request.resource.data.historico.size() == resource.data.get('historico', []).size() + 1;
    }

    // Código de vínculo com o Telegram: o app só cria, para o próprio usuário.
    // Conferir e marcar como usado é com o bot (Admin SDK).
    match /codigosVinculo/{codigo} {
      allow create: if logado() && request.resource.data.uid == request.auth.uid;
    }

    // Desvincular: o dono só pode desligar o próprio vínculo.
    match /telegramVinculos/{chatId} {
      allow update: if logado()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo']);
    }

    match /sugestoes/{sugestaoId} {
      allow read, write: if logado();
    }

    match /usuarios/{userId} {
      allow read, write: if logado() && request.auth.uid == userId;
    }

    match /listas/{listaId} {
      // Qualquer logado abre UMA lista pelo id (o link ?lista=<id>), mas não
      // pode listar a coleção: isso expunha todas as casas e o e-mail de quem
      // criou cada uma. O app só usa getDoc aqui.
      allow get: if logado();

      // Criador pode fazer tudo
      // Participante pode atualizar
      // Quem não participa só pode se acrescentar como participante
      allow create, delete: if logado() && request.auth.uid == listaId;
      allow update: if logado() && (
        request.auth.uid == listaId ||
        participaDaLista(listaId) ||
        soEntrandoNoGrupo()
      );

      match /lista/{itemId} {
        allow read, write: if logado() && participaDaLista(listaId);
      }
    }
    
    match /receitas/{receitaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if ehAdmin();
    }

    match /dicas/{dicaId} {
      allow read: if logado();
      allow write: if ehAdmin();
    }
  }
}